APP_NAME="Muhindo Mubaraka"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8888/muhindo-app
APP_FOLDER=/Applications/MAMP/htdocs/muhindo-app

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=muhindo_app
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

BROADCAST_DRIVER=log
REDIS_CLIENT=predis
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=43200

MAIL_MAILER=smtp

# The cPanel mailbox on this same account. Port 465 is the SSL/TLS port, which
# is why MAIL_SCHEME is smtps: the connection is encrypted from the first byte.
# Use port 587 with MAIL_SCHEME left empty for STARTTLS instead, where the
# connection opens plain and is upgraded.
#
# MAIL_ENCRYPTION is deliberately gone. config/mail.php has read MAIL_SCHEME
# since Laravel 11 and never looks at MAIL_ENCRYPTION, so leaving it set says
# "this is encrypted" while doing nothing at all.
MAIL_SCHEME=smtps
MAIL_HOST=muhindomubaraka.com
MAIL_PORT=465
# The FULL address, not just the mailbox name.
MAIL_USERNAME=noreply@muhindomubaraka.com
MAIL_PASSWORD=
# Matches the account being authenticated with, which is what keeps the server
# from refusing the sender and what keeps SPF aligned.
MAIL_FROM_ADDRESS=noreply@muhindomubaraka.com
MAIL_FROM_NAME="Muhindo Mubaraka"

# CORS
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false

# Flutterwave Payment Gateway — get keys from your Flutterwave dashboard.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com
FLW_CURRENCY=UGX
FLW_PAYMENT_OPTIONS=card,mobilemoneyuganda,banktransfer,ussd
FLW_TIMEOUT=20

# Optional — auto-fetches a pasted YouTube lesson video's duration in the curriculum
# builder. Leave blank to skip this (duration stays a manual field). Get a key from
# https://console.cloud.google.com/apis/credentials with the YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# Google reCAPTCHA v2 — https://www.google.com/recaptcha/admin
# Empty means off: every public form keeps working and falls back to the
# honeypot in App\Support\Spam\FormShield. Fill both to switch the widget on.
NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

# Search engine ownership verification. See config/seo.php. Google's token is
# committed there because it is public and must survive a deploy; these are for
# providers added later without touching code.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
