includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

# Static analysis gate.
#
# Level 5 is where this codebase already sits once the known findings are
# baselined. Almost all of those are Larastan not knowing a model's casts():
# it reads the column type from the schema, sees a string, and objects to
# ->isPast() on a date that Laravel does in fact hand back as a Carbon. Those
# are annotation gaps, not defects, which is why they are recorded rather than
# chased.
#
# The baseline is the point. It means the 60 existing findings cannot grow: a
# new one fails the build even though the old ones do not. Raise the level or
# shrink the baseline when there is a reason to, not on a schedule.
parameters:
    level: 5
    paths:
        - app
    checkModelProperties: false
    treatPhpDocTypesAsCertain: false
